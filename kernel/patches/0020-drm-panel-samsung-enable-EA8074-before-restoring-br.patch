From dd99b14a19e37f5acc52eae3331e1c31877422e5 Mon Sep 17 00:00:00 2001
From: Andrei Radulescu <andi.radulescu@gmail.com>
Date: Mon, 31 Aug 2026 01:21:22 +0300
Subject: [PATCH] drm/panel: samsung: enable EA8074 before restoring brightness

Restore the display state before writing nonzero brightness on unblank.
This preserves the previously validated EA8074 wake ordering while
explicit blanking still writes brightness zero before DISPLAY_OFF.

Signed-off-by: Andrei Radulescu <andi.radulescu@gmail.com>
---
 drivers/gpu/drm/panel/panel-samsung-ea8074.c | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-samsung-ea8074.c b/drivers/gpu/drm/panel/panel-samsung-ea8074.c
index 01ee6c3..f7deb47 100644
--- a/drivers/gpu/drm/panel/panel-samsung-ea8074.c
+++ b/drivers/gpu/drm/panel/panel-samsung-ea8074.c
@@ -322,6 +322,12 @@ static int samsung_ea8074_bl_update_status(struct backlight_device *bl)
 	if (!ctx->enabled)
 		goto out_unlock;
 
+	if (!blanked) {
+		ret = samsung_ea8074_set_display_state(ctx, true);
+		if (ret < 0)
+			goto out_unlock;
+	}
+
 	mode_flags = ctx->dsi->mode_flags;
 	ctx->dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
 	ret = mipi_dsi_dcs_set_display_brightness_large(ctx->dsi, brightness);
@@ -331,8 +337,6 @@ static int samsung_ea8074_bl_update_status(struct backlight_device *bl)
 		display_ret = samsung_ea8074_set_display_state(ctx, false);
 		if (!ret)
 			ret = display_ret;
-	} else if (!ret) {
-		ret = samsung_ea8074_set_display_state(ctx, true);
 	}
 
 out_unlock:
-- 

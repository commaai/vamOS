From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Robin Reckmann <robin.reckmann@gmail.com>
Date: Sat, 18 Jul 2026 00:00:00 +0000
Subject: drm/msm: map inherited splash memory into display IOMMU

The boot chain leaves MDSS/DPU scanning out a splash framebuffer when
entering Linux. During msm display probe Linux attaches the display SMMU
domain before the driver has fully taken over and reprogrammed the
pipeline. The inherited scanout therefore continues to fetch the splash
address through the newly attached domain and faults because the address
is not mapped there.

The device tree describes the inherited splash framebuffer as an MDSS
reserved-memory region. Identity-map that region read-only immediately
after attaching the display IOMMU, while the page tables first become
usable. This keeps inherited scanout reads valid only for the handoff
window; normal DRM modeset still takes over the pipeline afterwards.

Signed-off-by: Robin Reckmann <robin.reckmann@gmail.com>
---
 drivers/gpu/drm/msm/msm_iommu.c | 26 ++++++++++++++++++++++++++
 1 file changed, 26 insertions(+)

diff --git a/drivers/gpu/drm/msm/msm_iommu.c b/drivers/gpu/drm/msm/msm_iommu.c
index 058c71c82..c1141c754 100644
--- a/drivers/gpu/drm/msm/msm_iommu.c
+++ b/drivers/gpu/drm/msm/msm_iommu.c
@@ -7,6 +7,7 @@
 #include <linux/adreno-smmu-priv.h>
 #include <linux/io-pgtable.h>
 #include <linux/kmemleak.h>
+#include <linux/of_reserved_mem.h>
 #include "msm_drv.h"
 #include "msm_gpu_trace.h"
 #include "msm_mmu.h"
@@ -759,6 +760,27 @@ struct msm_mmu *msm_iommu_new(struct device *dev, unsigned long quirks)
 	return &iommu->base;
 }
 
+static void msm_iommu_map_boot_splash(struct msm_iommu *iommu)
+{
+	struct resource res;
+	phys_addr_t start;
+	size_t size;
+	int ret;
+
+	/* Board-described framebuffer inherited from bootloader scanout. */
+	ret = of_reserved_mem_region_to_resource(iommu->base.dev->of_node, 0, &res);
+	if (ret)
+		return;
+
+	start = res.start;
+	size = resource_size(&res);
+
+	ret = iommu_map(iommu->domain, start, start, size, IOMMU_READ,
+			GFP_KERNEL);
+	if (ret)
+		return;
+}
+
 struct msm_mmu *msm_iommu_disp_new(struct device *dev, unsigned long quirks)
 {
 	struct msm_iommu *iommu;
@@ -769,6 +791,10 @@ struct msm_mmu *msm_iommu_disp_new(struct device *dev, unsigned long quirks)
 
 	iommu = to_msm_iommu(mmu);
 	iommu_set_fault_handler(iommu->domain, msm_disp_fault_handler, iommu);
+
+	/* arm-smmu creates the page table during attach. */
+	msm_iommu_map_boot_splash(iommu);
+
 
 	return mmu;
 }

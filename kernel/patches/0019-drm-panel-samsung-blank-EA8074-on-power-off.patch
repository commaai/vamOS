From 715ef9627b7f3e66a2778715dd257f399bb411cc Mon Sep 17 00:00:00 2001
From: Andrei Radulescu <andi.radulescu@gmail.com>
Date: Mon, 31 Aug 2026 01:15:11 +0300
Subject: [PATCH] drm/panel: samsung: blank EA8074 on power-off

backlight_get_brightness() maps both brightness zero and an explicit
blank request to zero. The EA8074 continues scanning at brightness zero,
so bl_power does not make the AMOLED fully black.

Keep brightness zero as a valid dimming level. Use the backlight blank
state to send DISPLAY_OFF and DISPLAY_ON without entering sleep, while
preserving the full panel-disable sleep sequence.

Signed-off-by: Andrei Radulescu <andi.radulescu@gmail.com>
---
 drivers/gpu/drm/panel/panel-samsung-ea8074.c | 112 +++++++++++++++----
 1 file changed, 91 insertions(+), 21 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-samsung-ea8074.c b/drivers/gpu/drm/panel/panel-samsung-ea8074.c
index 1926423..01ee6c3 100644
--- a/drivers/gpu/drm/panel/panel-samsung-ea8074.c
+++ b/drivers/gpu/drm/panel/panel-samsung-ea8074.c
@@ -11,6 +11,7 @@
 #include <linux/delay.h>
 #include <linux/gpio/consumer.h>
 #include <linux/module.h>
+#include <linux/mutex.h>
 #include <linux/of.h>
 #include <linux/regulator/consumer.h>
 
@@ -32,6 +33,10 @@ struct samsung_ea8074 {
 	struct regulator_bulk_data *supplies;
 	struct gpio_desc *reset_gpio;
 	const struct samsung_ea8074_panel_desc *desc;
+	/* Protects panel state and DSI commands. */
+	struct mutex lock;
+	bool enabled;
+	bool display_on;
 };
 
 static const struct regulator_bulk_data ea8074_supplies[] = {
@@ -49,6 +54,26 @@ struct samsung_ea8074 *to_samsung_ea8074(struct drm_panel *panel)
 	return container_of(panel, struct samsung_ea8074, panel);
 }
 
+static int samsung_ea8074_set_display_state(struct samsung_ea8074 *ctx,
+					    bool display_on)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	if (ctx->display_on == display_on)
+		return 0;
+
+	if (display_on)
+		mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
+	else
+		mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
+	if (dsi_ctx.accum_err)
+		return dsi_ctx.accum_err;
+
+	ctx->display_on = display_on;
+
+	return 0;
+}
+
 #define ea8074_test_key_on_lvl2(ctx) \
 	mipi_dsi_dcs_write_seq_multi(ctx, 0xf0, 0x5a, 0x5a)
 #define ea8074_test_key_off_lvl2(ctx) \
@@ -187,26 +212,46 @@ static int ams621rc_init_sequence(struct mipi_dsi_multi_context *dsi_ctx)
 static int samsung_ea8074_enable(struct drm_panel *panel)
 {
 	struct samsung_ea8074 *ctx = to_samsung_ea8074(panel);
-	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+	int ret;
 
-	mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
-	mipi_dsi_msleep(&dsi_ctx, 120);
+	mutex_lock(&ctx->lock);
+
+	ret = samsung_ea8074_set_display_state(ctx, true);
+	if (ret < 0)
+		goto out_unlock;
 
-	return dsi_ctx.accum_err;
+	msleep(120);
+	ctx->enabled = true;
+
+out_unlock:
+	mutex_unlock(&ctx->lock);
+
+	return ret;
 }
 
 static int samsung_ea8074_disable(struct drm_panel *panel)
 {
 	struct samsung_ea8074 *ctx = to_samsung_ea8074(panel);
 	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+	int ret;
 
-	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
-	mipi_dsi_usleep_range(&dsi_ctx, 17000, 18000);
+	mutex_lock(&ctx->lock);
+	ctx->enabled = false;
+
+	ret = samsung_ea8074_set_display_state(ctx, false);
+	if (ret < 0)
+		goto out_unlock;
+
+	usleep_range(17000, 18000);
 
 	mipi_dsi_dcs_enter_sleep_mode_multi(&dsi_ctx);
 	mipi_dsi_msleep(&dsi_ctx, 120);
+	ret = dsi_ctx.accum_err;
+
+out_unlock:
+	mutex_unlock(&ctx->lock);
 
-	return dsi_ctx.accum_err;
+	return ret;
 }
 
 static int samsung_ea8074_prepare(struct drm_panel *panel)
@@ -238,6 +283,11 @@ static int samsung_ea8074_unprepare(struct drm_panel *panel)
 	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
 	regulator_bulk_disable(ARRAY_SIZE(ea8074_supplies), ctx->supplies);
 
+	mutex_lock(&ctx->lock);
+	ctx->enabled = false;
+	ctx->display_on = false;
+	mutex_unlock(&ctx->lock);
+
 	return 0;
 }
 
@@ -259,19 +309,36 @@ static const struct drm_panel_funcs samsung_ea8074_panel_funcs = {
 
 static int samsung_ea8074_bl_update_status(struct backlight_device *bl)
 {
-	struct mipi_dsi_device *dsi = bl_get_data(bl);
-	u16 brightness = backlight_get_brightness(bl);
-	int err;
-
-	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
-
-	err = mipi_dsi_dcs_set_display_brightness_large(dsi, brightness);
-	if (err < 0)
-		return err;
+	struct samsung_ea8074 *ctx = bl_get_data(bl);
+	/* Brightness zero is a dimming level, not an explicit blank request. */
+	bool blanked = backlight_is_blank(bl);
+	u16 brightness = blanked ? 0 : bl->props.brightness;
+	unsigned long mode_flags;
+	int display_ret;
+	int ret = 0;
+
+	mutex_lock(&ctx->lock);
+
+	if (!ctx->enabled)
+		goto out_unlock;
+
+	mode_flags = ctx->dsi->mode_flags;
+	ctx->dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+	ret = mipi_dsi_dcs_set_display_brightness_large(ctx->dsi, brightness);
+	ctx->dsi->mode_flags = mode_flags;
+
+	if (blanked) {
+		display_ret = samsung_ea8074_set_display_state(ctx, false);
+		if (!ret)
+			ret = display_ret;
+	} else if (!ret) {
+		ret = samsung_ea8074_set_display_state(ctx, true);
+	}
 
-	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+out_unlock:
+	mutex_unlock(&ctx->lock);
 
-	return 0;
+	return ret;
 }
 
 static const struct backlight_ops samsung_ea8074_bl_ops = {
@@ -279,8 +346,9 @@ static const struct backlight_ops samsung_ea8074_bl_ops = {
 };
 
 static struct backlight_device *
-samsung_ea8074_create_backlight(struct mipi_dsi_device *dsi)
+samsung_ea8074_create_backlight(struct samsung_ea8074 *ctx)
 {
+	struct mipi_dsi_device *dsi = ctx->dsi;
 	struct device *dev = &dsi->dev;
 	const struct backlight_properties props = {
 		.type = BACKLIGHT_RAW,
@@ -288,7 +356,7 @@ samsung_ea8074_create_backlight(struct mipi_dsi_device *dsi)
 		.max_brightness = 1023,
 	};
 
-	return devm_backlight_device_register(dev, dev_name(dev), dev, dsi,
+	return devm_backlight_device_register(dev, dev_name(dev), dev, ctx,
 					      &samsung_ea8074_bl_ops, &props);
 }
 
@@ -327,7 +395,9 @@ static int samsung_ea8074_probe(struct mipi_dsi_device *dsi)
 
 	ctx->panel.prepare_prev_first = true;
 
-	ctx->panel.backlight = samsung_ea8074_create_backlight(dsi);
+	mutex_init(&ctx->lock);
+
+	ctx->panel.backlight = samsung_ea8074_create_backlight(ctx);
 	if (IS_ERR(ctx->panel.backlight))
 		return dev_err_probe(dev, PTR_ERR(ctx->panel.backlight),
 				     "Failed to create backlight\n");
-- 

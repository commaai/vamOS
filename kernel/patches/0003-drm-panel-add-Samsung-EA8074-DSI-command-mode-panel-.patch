From da9ddab77d9dcf1ece630f136a1f2cd7cde55df3 Mon Sep 17 00:00:00 2001
From: Andrei Radulescu <andi.radulescu@gmail.com>
Date: Mon, 27 Jul 2026 18:48:20 +0300
Subject: [PATCH] drm/panel: add Samsung EA8074 panel driver

Add support for the Samsung EA8074 AMOLED display driver IC and the
AMS601NT01, AMS621RC, and L590NT06 panels.

Brightness zero does not stop image output on these panels. Track the
display state and issue DISPLAY_OFF and DISPLAY_ON from the backlight
callback so blanking physically darkens the panel without entering sleep.

Signed-off-by: Andrei Radulescu <andi.radulescu@gmail.com>
---
 .../display/panel/samsung,ea8074.yaml         |  91 ++++
 drivers/gpu/drm/panel/Kconfig                 |  15 +
 drivers/gpu/drm/panel/Makefile                |   1 +
 drivers/gpu/drm/panel/panel-samsung-ea8074.c  | 517 +++++++++++++++++++
 4 files changed, 624 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/display/panel/samsung,ea8074.yaml
 create mode 100644 drivers/gpu/drm/panel/panel-samsung-ea8074.c

diff --git a/Documentation/devicetree/bindings/display/panel/samsung,ea8074.yaml b/Documentation/devicetree/bindings/display/panel/samsung,ea8074.yaml
new file mode 100644
index 000000000000..edf254823184
--- /dev/null
+++ b/Documentation/devicetree/bindings/display/panel/samsung,ea8074.yaml
@@ -0,0 +1,91 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/panel/samsung,ea8074.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung EA8074 AMOLED DDIC
+
+maintainers:
+  - David Heidelberg <david@ixit.cz>
+
+description: |
+  The Samsung EA8074 is a display driver IC used with AMOLED panels.
+
+allOf:
+  - $ref: panel-common.yaml#
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: samsung,ea8074-l590nt06
+    then:
+      required:
+        - vddcore-supply
+    else:
+      required:
+        - elvdd-supply
+        - elvss-supply
+
+properties:
+  compatible:
+    items:
+      - enum:
+           # Samsung 6.01 inch, 1080x2160 pixels
+          - samsung,ea8074-ams601nt01
+           # Samsung 6.21 inch, 1080x2248 pixels
+          - samsung,ea8074-ams621rc
+           # Samsung 5.9 inch, 1080x2160 pixels
+          - samsung,ea8074-l590nt06
+      - const: samsung,ea8074
+
+  reg:
+    maxItems: 1
+
+  elvdd-supply:
+    description: EL driving positive voltage supply
+
+  elvss-supply:
+    description: EL driving negative voltage supply
+
+  vddio-supply:
+    description: I/O voltage supply
+
+  vddcore-supply:
+    description: Panel core voltage supply
+
+required:
+  - compatible
+  - reg
+  - reset-gpios
+  - vddio-supply
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    dsi {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        panel@0 {
+            compatible = "samsung,ea8074-ams621rc", "samsung,ea8074";
+            reg = <0>;
+
+            reset-gpios = <&tlmm 6 GPIO_ACTIVE_LOW>;
+
+            vddio-supply = <&vreg_l14a_1p8>;
+            elvdd-supply = <&lab>;
+            elvss-supply = <&ibb>;
+
+            port {
+                panel_in: endpoint {
+                    remote-endpoint = <&dsi0_out>;
+                };
+            };
+        };
+    };
+
+...
diff --git a/drivers/gpu/drm/panel/Kconfig b/drivers/gpu/drm/panel/Kconfig
index 407c5f6a268b..3a6298902d69 100644
--- a/drivers/gpu/drm/panel/Kconfig
+++ b/drivers/gpu/drm/panel/Kconfig
@@ -762,6 +762,21 @@ config DRM_PANEL_SAMSUNG_DB7430
 	  DB7430 DPI display controller used in such devices as the
 	  LMS397KF04 480x800 DPI panel.
 
+config DRM_PANEL_SAMSUNG_EA8074
+	tristate "Samsung EA8074 DSI command mode panel"
+	depends on OF
+	depends on DRM_MIPI_DSI
+	depends on BACKLIGHT_CLASS_DEVICE
+	help
+	  Say Y or M here if you want to enable support for the
+	  Samsung EA8074 display driver IC and connected panel.
+
+	  Currently supported panels:
+
+	    Samsung AMS601NT01 (found in the Huawei Mate 10 Pro)
+	    Samsung AMS621RC (found in the Xiaomi Mi 8 smartphone)
+	    Samsung L590NT06 (found in the comma three)
+
 config DRM_PANEL_SAMSUNG_LD9040
 	tristate "Samsung LD9040 RGB/SPI panel"
 	depends on OF && SPI
diff --git a/drivers/gpu/drm/panel/Makefile b/drivers/gpu/drm/panel/Makefile
index 3615a761b44f..9989a96f8dea 100644
--- a/drivers/gpu/drm/panel/Makefile
+++ b/drivers/gpu/drm/panel/Makefile
@@ -74,6 +74,7 @@ obj-$(CONFIG_DRM_PANEL_SAMSUNG_AMS581VF01) += panel-samsung-ams581vf01.o
 obj-$(CONFIG_DRM_PANEL_SAMSUNG_AMS639RQ08) += panel-samsung-ams639rq08.o
 obj-$(CONFIG_DRM_PANEL_SAMSUNG_ATNA33XC20) += panel-samsung-atna33xc20.o
 obj-$(CONFIG_DRM_PANEL_SAMSUNG_DB7430) += panel-samsung-db7430.o
+obj-$(CONFIG_DRM_PANEL_SAMSUNG_EA8074) += panel-samsung-ea8074.o
 obj-$(CONFIG_DRM_PANEL_SAMSUNG_LD9040) += panel-samsung-ld9040.o
 obj-$(CONFIG_DRM_PANEL_SAMSUNG_S6D16D0) += panel-samsung-s6d16d0.o
 obj-$(CONFIG_DRM_PANEL_SAMSUNG_S6D27A1) += panel-samsung-s6d27a1.o
diff --git a/drivers/gpu/drm/panel/panel-samsung-ea8074.c b/drivers/gpu/drm/panel/panel-samsung-ea8074.c
new file mode 100644
index 000000000000..27b5f22292de
--- /dev/null
+++ b/drivers/gpu/drm/panel/panel-samsung-ea8074.c
@@ -0,0 +1,517 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * DRM driver for the Samsung EA8074 display driver IC and associated panel.
+ *
+ * Copyright 2022 Eralp Çelebi <eralp.celebi.personal@gmail.com>
+ * Copyright 2026 Max Furman <taygoth@gmail.com>
+ * Copyright 2026 David Heidelberg <david@ixit.cz>
+ */
+
+#include <linux/backlight.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/regulator/consumer.h>
+
+#include <video/mipi_display.h>
+
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+#include <drm/drm_probe_helper.h>
+
+struct samsung_ea8074_panel_desc {
+	const struct drm_display_mode *mode;
+	int (*init_sequence)(struct mipi_dsi_multi_context *dsi_ctx);
+	const struct regulator_bulk_data *supplies;
+	unsigned int num_supplies;
+};
+
+struct samsung_ea8074 {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	struct regulator_bulk_data *supplies;
+	struct gpio_desc *reset_gpio;
+	const struct samsung_ea8074_panel_desc *desc;
+	/* Protects display state and backlight DSI commands. */
+	struct mutex lock;
+	bool enabled;
+	bool display_on;
+};
+
+static const struct regulator_bulk_data ea8074_amoled_supplies[] = {
+	{ .supply = "vddio",
+	  .init_load_uA = 62000 },
+	{ .supply = "elvdd",
+	  .init_load_uA = 100000 },
+	{ .supply = "elvss",
+	  .init_load_uA = 100000 },
+};
+
+static const struct regulator_bulk_data l590nt06_supplies[] = {
+	{ .supply = "vddio",
+	  .init_load_uA = 62000 },
+	{ .supply = "vddcore" },
+};
+
+static inline
+struct samsung_ea8074 *to_samsung_ea8074(struct drm_panel *panel)
+{
+	return container_of(panel, struct samsung_ea8074, panel);
+}
+
+static int samsung_ea8074_set_display_state(struct samsung_ea8074 *ctx,
+					    bool display_on)
+{
+	int ret;
+
+	if (ctx->display_on == display_on)
+		return 0;
+
+	if (display_on)
+		ret = mipi_dsi_dcs_set_display_on(ctx->dsi);
+	else
+		ret = mipi_dsi_dcs_set_display_off(ctx->dsi);
+	if (ret < 0)
+		return ret;
+
+	ctx->display_on = display_on;
+
+	return 0;
+}
+
+#define ea8074_test_key_on_lvl2(ctx) \
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xf0, 0x5a, 0x5a)
+#define ea8074_test_key_off_lvl2(ctx) \
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xf0, 0xa5, 0xa5)
+#define ea8074_test_key_on_lvl3(ctx) \
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xfc, 0x5a, 0x5a)
+#define ea8074_test_key_off_lvl3(ctx) \
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xfc, 0xa5, 0xa5)
+
+static void samsung_ea8074_reset(struct samsung_ea8074 *ctx)
+{
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(1000, 2000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	usleep_range(1000, 2000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(10000, 11000);
+}
+
+static int l590nt06_init_sequence(struct mipi_dsi_multi_context *dsi_ctx)
+{
+	mipi_dsi_dcs_exit_sleep_mode_multi(dsi_ctx);
+	mipi_dsi_usleep_range(dsi_ctx, 10000, 11000);
+
+	mipi_dsi_dcs_set_column_address_multi(dsi_ctx, 0x0000, 0x0437);
+	mipi_dsi_usleep_range(dsi_ctx, 10000, 11000);
+
+	mipi_dsi_dcs_set_page_address_multi(dsi_ctx, 0x0000, 0x0800 | 0x006f);
+	mipi_dsi_usleep_range(dsi_ctx, 10000, 11000);
+
+	mipi_dsi_dcs_set_tear_on_multi(dsi_ctx, MIPI_DSI_DCS_TEAR_MODE_VBLANK);
+	mipi_dsi_usleep_range(dsi_ctx, 10000, 11000);
+
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, MIPI_DCS_WRITE_CONTROL_DISPLAY,
+				     0x20);
+	mipi_dsi_usleep_range(dsi_ctx, 10000, 11000);
+
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, MIPI_DCS_SET_DISPLAY_BRIGHTNESS,
+				     0x00, 0x00);
+	mipi_dsi_usleep_range(dsi_ctx, 10000, 11000);
+
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, MIPI_DCS_WRITE_POWER_SAVE, 0x00);
+	mipi_dsi_usleep_range(dsi_ctx, 10000, 11000);
+
+	/* Unlock Samsung vendor registers */
+	ea8074_test_key_on_lvl2(dsi_ctx);
+	mipi_dsi_usleep_range(dsi_ctx, 10000, 11000);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xb0, 0x06);
+	mipi_dsi_usleep_range(dsi_ctx, 10000, 11000);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xef, 0x35);
+	mipi_dsi_usleep_range(dsi_ctx, 10000, 11000);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xcc, 0x55, 0x12);
+	mipi_dsi_usleep_range(dsi_ctx, 10000, 11000);
+
+	ea8074_test_key_on_lvl3(dsi_ctx);
+	mipi_dsi_usleep_range(dsi_ctx, 10000, 11000);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xb0, 0x01);
+	mipi_dsi_usleep_range(dsi_ctx, 10000, 11000);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xd2, 0x20);
+	mipi_dsi_usleep_range(dsi_ctx, 10000, 11000);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xb0, 0x05);
+	mipi_dsi_usleep_range(dsi_ctx, 10000, 11000);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xd2, 0x40);
+	mipi_dsi_usleep_range(dsi_ctx, 10000, 11000);
+	ea8074_test_key_off_lvl3(dsi_ctx);
+	mipi_dsi_usleep_range(dsi_ctx, 10000, 11000);
+
+	ea8074_test_key_off_lvl2(dsi_ctx);
+	mipi_dsi_msleep(dsi_ctx, 110);
+
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, MIPI_DCS_WRITE_MEMORY_START);
+	mipi_dsi_usleep_range(dsi_ctx, 10000, 11000);
+
+	mipi_dsi_dcs_set_display_on_multi(dsi_ctx);
+	mipi_dsi_usleep_range(dsi_ctx, 10000, 11000);
+
+	/* Post display-on vendor configuration */
+	ea8074_test_key_on_lvl2(dsi_ctx);
+	mipi_dsi_usleep_range(dsi_ctx, 10000, 11000);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xb0, 0x05);
+	mipi_dsi_usleep_range(dsi_ctx, 10000, 11000);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xb1, 0x40);
+	mipi_dsi_usleep_range(dsi_ctx, 10000, 11000);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xb0, 0x03);
+	mipi_dsi_usleep_range(dsi_ctx, 10000, 11000);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xb6, 0xa2);
+	mipi_dsi_usleep_range(dsi_ctx, 10000, 11000);
+	ea8074_test_key_off_lvl2(dsi_ctx);
+	mipi_dsi_usleep_range(dsi_ctx, 10000, 11000);
+
+	return dsi_ctx->accum_err;
+}
+
+static int ams621rc_init_sequence(struct mipi_dsi_multi_context *dsi_ctx)
+{
+	mipi_dsi_dcs_exit_sleep_mode_multi(dsi_ctx);
+	mipi_dsi_usleep_range(dsi_ctx, 10000, 11000);
+
+	mipi_dsi_dcs_set_page_address_multi(dsi_ctx, 0x0000, 0x0800 | 0x00c7);
+	mipi_dsi_usleep_range(dsi_ctx, 10000, 11000);
+
+	ea8074_test_key_on_lvl2(dsi_ctx);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xef, 0xf0, 0x31, 0x00, 0x33, 0x31, 0x14, 0x35);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xb0, 0x01);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xbb, 0x03);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xb0, 0x4f);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xcb, 0x00);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xb0, 0x6b);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xcb, 0x00);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xf7, 0x03);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xb0, 0x05);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xb1, 0x10);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xb0, 0x02);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xd5, 0x02, 0x17, 0x54, 0x14);
+	ea8074_test_key_off_lvl2(dsi_ctx);
+
+	ea8074_test_key_on_lvl2(dsi_ctx);
+	ea8074_test_key_on_lvl3(dsi_ctx);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xd2, 0x9f, 0xf0);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xb0, 0x0e);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xd2, 0x70);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xb0, 0x04);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xd2, 0x20);
+	ea8074_test_key_off_lvl2(dsi_ctx);
+	ea8074_test_key_off_lvl3(dsi_ctx);
+
+	mipi_dsi_dcs_set_tear_on_multi(dsi_ctx, MIPI_DSI_DCS_TEAR_MODE_VBLANK);
+
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, MIPI_DCS_WRITE_CONTROL_DISPLAY, 0x20);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, MIPI_DCS_WRITE_POWER_SAVE, 0x00);
+	mipi_dsi_msleep(dsi_ctx, 110);
+
+	return dsi_ctx->accum_err;
+}
+
+static int samsung_ea8074_enable(struct drm_panel *panel)
+{
+	struct samsung_ea8074 *ctx = to_samsung_ea8074(panel);
+	int ret;
+
+	mutex_lock(&ctx->lock);
+
+	ret = samsung_ea8074_set_display_state(ctx, true);
+	if (ret < 0)
+		goto out_unlock;
+
+	msleep(120);
+	ctx->enabled = true;
+
+out_unlock:
+	mutex_unlock(&ctx->lock);
+
+	return ret;
+}
+
+static int samsung_ea8074_disable(struct drm_panel *panel)
+{
+	struct samsung_ea8074 *ctx = to_samsung_ea8074(panel);
+	int ret;
+
+	mutex_lock(&ctx->lock);
+	ctx->enabled = false;
+
+	ret = samsung_ea8074_set_display_state(ctx, false);
+	if (ret < 0)
+		goto out_unlock;
+
+	usleep_range(17000, 18000);
+
+	ret = mipi_dsi_dcs_enter_sleep_mode(ctx->dsi);
+	if (ret < 0)
+		goto out_unlock;
+
+	msleep(120);
+
+out_unlock:
+	mutex_unlock(&ctx->lock);
+
+	return ret;
+}
+
+static int samsung_ea8074_prepare(struct drm_panel *panel)
+{
+	struct samsung_ea8074 *ctx = to_samsung_ea8074(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+	int ret;
+
+	ret = regulator_bulk_enable(ctx->desc->num_supplies, ctx->supplies);
+	if (ret < 0)
+		return ret;
+
+	samsung_ea8074_reset(ctx);
+
+	ret = ctx->desc->init_sequence(&dsi_ctx);
+	if (ret < 0) {
+		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+		regulator_bulk_disable(ctx->desc->num_supplies, ctx->supplies);
+		return ret;
+	}
+
+	return 0;
+}
+
+static int samsung_ea8074_unprepare(struct drm_panel *panel)
+{
+	struct samsung_ea8074 *ctx = to_samsung_ea8074(panel);
+
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	regulator_bulk_disable(ctx->desc->num_supplies, ctx->supplies);
+
+	mutex_lock(&ctx->lock);
+	ctx->display_on = false;
+	mutex_unlock(&ctx->lock);
+
+	return 0;
+}
+
+static int samsung_ea8074_get_modes(struct drm_panel *panel,
+				    struct drm_connector *connector)
+{
+	struct samsung_ea8074 *ctx = to_samsung_ea8074(panel);
+
+	return drm_connector_helper_get_modes_fixed(connector, ctx->desc->mode);
+}
+
+static const struct drm_panel_funcs samsung_ea8074_panel_funcs = {
+	.enable = samsung_ea8074_enable,
+	.prepare = samsung_ea8074_prepare,
+	.disable = samsung_ea8074_disable,
+	.unprepare = samsung_ea8074_unprepare,
+	.get_modes = samsung_ea8074_get_modes,
+};
+
+static int samsung_ea8074_bl_update_status(struct backlight_device *bl)
+{
+	struct samsung_ea8074 *ctx = bl_get_data(bl);
+	u16 brightness = backlight_get_brightness(bl);
+	unsigned long mode_flags;
+	int ret = 0;
+
+	mutex_lock(&ctx->lock);
+
+	if (!ctx->enabled)
+		goto out_unlock;
+
+	if (brightness) {
+		ret = samsung_ea8074_set_display_state(ctx, true);
+		if (ret < 0)
+			goto out_unlock;
+	}
+
+	mode_flags = ctx->dsi->mode_flags;
+	ctx->dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+	ret = mipi_dsi_dcs_set_display_brightness_large(ctx->dsi, brightness);
+	ctx->dsi->mode_flags = mode_flags;
+	if (ret < 0)
+		goto out_unlock;
+
+	/*
+	 * Brightness zero leaves this AMOLED scanning out the last frame.
+	 * Disable image output without putting the panel into sleep mode.
+	 */
+	if (!brightness)
+		ret = samsung_ea8074_set_display_state(ctx, false);
+
+out_unlock:
+	mutex_unlock(&ctx->lock);
+
+	return ret;
+}
+
+static const struct backlight_ops samsung_ea8074_bl_ops = {
+	.update_status = samsung_ea8074_bl_update_status,
+};
+
+static struct backlight_device *
+samsung_ea8074_create_backlight(struct samsung_ea8074 *ctx)
+{
+	struct mipi_dsi_device *dsi = ctx->dsi;
+	struct device *dev = &dsi->dev;
+	const struct backlight_properties props = {
+		.type = BACKLIGHT_RAW,
+		.brightness = 512,
+		.max_brightness = 1023,
+	};
+
+	return devm_backlight_device_register(dev, dev_name(dev), dev, ctx,
+					      &samsung_ea8074_bl_ops, &props);
+}
+
+static int samsung_ea8074_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct samsung_ea8074 *ctx;
+	int ret;
+
+	ctx = devm_drm_panel_alloc(dev, struct samsung_ea8074, panel,
+				   &samsung_ea8074_panel_funcs,
+				   DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	ctx->desc = of_device_get_match_data(dev);
+
+	ret = devm_regulator_bulk_get_const(dev,
+					    ctx->desc->num_supplies,
+					    ctx->desc->supplies,
+					    &ctx->supplies);
+	if (ret < 0)
+		return dev_err_probe(dev, ret, "Failed to get regulators\n");
+
+	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_LOW);
+	if (IS_ERR(ctx->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio),
+				     "Failed to get reset-gpios\n");
+
+	mipi_dsi_set_drvdata(dsi, ctx);
+
+	ctx->dsi = dsi;
+
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	dsi->mode_flags = MIPI_DSI_CLOCK_NON_CONTINUOUS | MIPI_DSI_MODE_LPM;
+
+	ctx->panel.prepare_prev_first = true;
+
+	mutex_init(&ctx->lock);
+
+	ctx->panel.backlight = samsung_ea8074_create_backlight(ctx);
+	if (IS_ERR(ctx->panel.backlight))
+		return dev_err_probe(dev, PTR_ERR(ctx->panel.backlight),
+				     "Failed to create backlight\n");
+
+	drm_panel_add(&ctx->panel);
+
+	ret = mipi_dsi_attach(dsi);
+	if (ret < 0) {
+		dev_err(dev, "Failed to attach to DSI host: %d\n", ret);
+		drm_panel_remove(&ctx->panel);
+		return ret;
+	}
+
+	return 0;
+}
+
+static void samsung_ea8074_remove(struct mipi_dsi_device *dsi)
+{
+	struct samsung_ea8074 *ctx = mipi_dsi_get_drvdata(dsi);
+	int ret;
+
+	ret = mipi_dsi_detach(dsi);
+	if (ret < 0)
+		dev_err(&dsi->dev, "Failed to detach from DSI host: %d\n", ret);
+
+	drm_panel_remove(&ctx->panel);
+}

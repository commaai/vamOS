From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Andrei Radulescu <andi.radulescu@gmail.com>
Date: Thu, 30 Jul 2026 16:00:00 +0300
Subject: [PATCH] qcom: support rebooting into EDL

Qualcomm platforms enter emergency download mode by programming the EDL
request before a warm reset through PS_HOLD. Some secure firmware does not
implement the deprecated SCM boot call, so use the existing secure TCSR
I/O path when the download-mode register is described by the device tree.

Handle the exact restart command "edl" in two ordered stages. The SCM
restart handler programs emergency download mode at firmware priority.
The MSM power-off driver selects a warm reset before the PMIC reboot
notifiers run, then deasserts PS_HOLD immediately after the SCM handler.
Other restart commands retain the existing PSCI behavior.

---
 drivers/firmware/qcom/qcom_scm.c   | 50 +++++++++++++++++++++++++++++++++
 drivers/firmware/qcom/qcom_scm.h   |  1 +
 drivers/power/reset/msm-poweroff.c | 57 ++++++++++++++++++++++++++++++++++----
 3 files changed, 102 insertions(+), 6 deletions(-)

diff --git a/drivers/firmware/qcom/qcom_scm.c b/drivers/firmware/qcom/qcom_scm.c
index e777b7cb9b12..85ec99bbf869 100644
--- a/drivers/firmware/qcom/qcom_scm.c
+++ b/drivers/firmware/qcom/qcom_scm.c
@@ -26,8 +26,10 @@
 #include <linux/of_platform.h>
 #include <linux/of_reserved_mem.h>
 #include <linux/platform_device.h>
+#include <linux/reboot.h>
 #include <linux/reset-controller.h>
 #include <linux/sizes.h>
+#include <linux/string.h>
 #include <linux/types.h>
 
 #include "qcom_scm.h"
@@ -146,6 +148,11 @@ static const char * const download_mode_name[] = {
 
 static struct qcom_scm *__scm;
 
+static bool qcom_scm_is_edl_reboot(const char *cmd)
+{
+	return cmd && !strcmp(cmd, "edl");
+}
+
 static int qcom_scm_clk_enable(void)
 {
 	int ret;
@@ -524,6 +531,42 @@ static int __qcom_scm_set_dload_mode(struct device *dev, bool enable)
 	return qcom_scm_call_atomic(__scm->dev, &desc, NULL);
 }
 
+static int qcom_scm_set_edl_mode(struct qcom_scm *scm)
+{
+	const struct qcom_scm_desc desc = {
+		.svc = QCOM_SCM_SVC_BOOT,
+		.cmd = QCOM_SCM_BOOT_SET_DLOAD_MODE,
+		.arginfo = QCOM_SCM_ARGS(2),
+		.args[0] = QCOM_SCM_BOOT_EDL_MODE,
+		.owner = ARM_SMCCC_OWNER_SIP,
+	};
+
+	if (scm->dload_mode_addr)
+		return qcom_scm_io_writel(scm->dload_mode_addr,
+					  QCOM_SCM_BOOT_EDL_MODE);
+
+	if (!__qcom_scm_is_call_available(scm->dev, QCOM_SCM_SVC_BOOT,
+					  QCOM_SCM_BOOT_SET_DLOAD_MODE))
+		return -EOPNOTSUPP;
+
+	return qcom_scm_call_atomic(scm->dev, &desc, NULL);
+}
+
+static int qcom_scm_restart(struct sys_off_data *data)
+{
+	struct qcom_scm *scm = data->cb_data;
+	int ret;
+
+	if (!qcom_scm_is_edl_reboot(data->cmd))
+		return NOTIFY_DONE;
+
+	ret = qcom_scm_set_edl_mode(scm);
+	if (ret)
+		dev_err(scm->dev, "failed to set emergency download mode: %d\n", ret);
+
+	return NOTIFY_DONE;
+}
+
 static int qcom_scm_io_rmw(phys_addr_t addr, unsigned int mask, unsigned int val)
 {
 	unsigned int old;
@@ -2408,6 +2451,13 @@ static int qcom_scm_probe(struct platform_device *pdev)
 					     "Failed to request qcom-scm irq\n");
 	}
 
+	ret = devm_register_sys_off_handler(scm->dev, SYS_OFF_MODE_RESTART,
+					    SYS_OFF_PRIO_FIRMWARE,
+					    qcom_scm_restart, scm);
+	if (ret)
+		return dev_err_probe(scm->dev, ret,
+				     "failed to register restart handler\n");
+
 	/*
 	 * Paired with smp_load_acquire() in qcom_scm_is_available().
 	 *
diff --git a/drivers/firmware/qcom/qcom_scm.h b/drivers/firmware/qcom/qcom_scm.h
index a56c8212cc0c..4a1f81508036 100644
--- a/drivers/firmware/qcom/qcom_scm.h
+++ b/drivers/firmware/qcom/qcom_scm.h
@@ -90,6 +90,7 @@ int qcom_scm_shm_bridge_enable(struct device *scm_dev);
 #define QCOM_SCM_BOOT_TERMINATE_PC	0x02
 #define QCOM_SCM_BOOT_SDI_CONFIG	0x09
 #define QCOM_SCM_BOOT_SET_DLOAD_MODE	0x10
+#define QCOM_SCM_BOOT_EDL_MODE		0x01
 #define QCOM_SCM_BOOT_SET_ADDR_MC	0x11
 #define QCOM_SCM_BOOT_SET_REMOTE_STATE	0x0a
 #define QCOM_SCM_FLUSH_FLAG_MASK	0x3
diff --git a/drivers/power/reset/msm-poweroff.c b/drivers/power/reset/msm-poweroff.c
index c7eb6dc8e90a..9cadc8d9a7d0 100644
--- a/drivers/power/reset/msm-poweroff.c
+++ b/drivers/power/reset/msm-poweroff.c
@@ -12,9 +12,31 @@
 #include <linux/module.h>
 #include <linux/reboot.h>
 #include <linux/pm.h>
+#include <linux/string.h>
 
 static void __iomem *msm_ps_hold;
 
+#define MSM_EDL_REBOOT_PRIORITY	128
+
+static bool msm_is_edl_reboot(const char *cmd)
+{
+	return cmd && !strcmp(cmd, "edl");
+}
+
+static int msm_edl_reboot_notify(struct notifier_block *nb,
+				 unsigned long action, void *data)
+{
+	if (action == SYS_RESTART && msm_is_edl_reboot(data))
+		reboot_mode = REBOOT_WARM;
+
+	return NOTIFY_DONE;
+}
+
+static struct notifier_block msm_edl_reboot_nb = {
+	.notifier_call = msm_edl_reboot_notify,
+	.priority = MSM_EDL_REBOOT_PRIORITY,
+};
+
 static int do_msm_poweroff(struct sys_off_data *data)
 {
 	writel(0, msm_ps_hold);
@@ -23,20 +45,43 @@ static int do_msm_poweroff(struct sys_off_data *data)
 	return NOTIFY_DONE;
 }
 
+static int do_msm_edl_restart(struct sys_off_data *data)
+{
+	if (!msm_is_edl_reboot(data->cmd))
+		return NOTIFY_DONE;
+
+	return do_msm_poweroff(data);
+}
+
 static int msm_restart_probe(struct platform_device *pdev)
 {
+	int ret;
+
 	msm_ps_hold = devm_platform_ioremap_resource(pdev, 0);
 	if (IS_ERR(msm_ps_hold))
 		return PTR_ERR(msm_ps_hold);
 
-	devm_register_sys_off_handler(&pdev->dev, SYS_OFF_MODE_RESTART,
-				      128, do_msm_poweroff, NULL);
+	ret = devm_register_reboot_notifier(&pdev->dev, &msm_edl_reboot_nb);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret,
+				     "failed to register EDL reboot notifier\n");
+
+	ret = devm_register_sys_off_handler(&pdev->dev, SYS_OFF_MODE_RESTART,
+					    SYS_OFF_PRIO_FIRMWARE - 1,
+					    do_msm_edl_restart, NULL);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret,
+				     "failed to register EDL restart handler\n");
 
-	devm_register_sys_off_handler(&pdev->dev, SYS_OFF_MODE_POWER_OFF,
-				      SYS_OFF_PRIO_DEFAULT, do_msm_poweroff,
-				      NULL);
+	ret = devm_register_sys_off_handler(&pdev->dev, SYS_OFF_MODE_RESTART,
+					    128, do_msm_poweroff, NULL);
+	if (ret)
+		return ret;
 
-	return 0;
+	return devm_register_sys_off_handler(&pdev->dev,
+					     SYS_OFF_MODE_POWER_OFF,
+					     SYS_OFF_PRIO_DEFAULT,
+					     do_msm_poweroff, NULL);
 }
 
 static const struct of_device_id of_msm_restart_match[] = {

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Andrei Radulescu <andi.radulescu@gmail.com>
Date: Fri, 31 Jul 2026 23:08:20 +0300
Subject: [PATCH] scsi: ufs: qcom: keep PHY powered during clock gating

Commit 77d2fa54a945 ("scsi: ufs: qcom : Refactor phy_power_on/off
calls") moved PHY power control from suspend and resume into
ufs_qcom_setup_clocks(). This makes every ordinary clock-gating cycle
disable the PHY clocks and regulators, including when the UFS core link
state remains active.

On SDM845 this produces recurring Physical Adapter and Data Link layer
errors as soon as clock gating becomes active. Qualcomm downstream and
the earlier mainline sequence keep the PHY powered across ordinary clock
gating and only power it off when suspending with the link off.

Restore that sequencing while retaining the later Hibern8 lane-clock
handling, ICE resume sequence, and UFS device reset delay.

Fixes: 77d2fa54a945 ("scsi: ufs: qcom : Refactor phy_power_on/off calls")
Signed-off-by: Andrei Radulescu <andi.radulescu@gmail.com>
---
 drivers/ufs/host/ufs-qcom.c | 40 +++++++++++++++++++---------------------
 1 file changed, 19 insertions(+), 21 deletions(-)

diff --git a/drivers/ufs/host/ufs-qcom.c b/drivers/ufs/host/ufs-qcom.c
index eba0e6617483..cb930c3a47e7 100644
--- a/drivers/ufs/host/ufs-qcom.c
+++ b/drivers/ufs/host/ufs-qcom.c
@@ -731,6 +731,8 @@ static int ufs_qcom_suspend(struct ufs_hba *hba, enum ufs_pm_op pm_op,
 	enum ufs_notify_change_status status)
 {
 	struct ufs_qcom_host *host = ufshcd_get_variant(hba);
+	struct phy *phy = host->generic_phy;
+	int err;
 
 	if (status == PRE_CHANGE)
 		return 0;
@@ -738,6 +740,13 @@ static int ufs_qcom_suspend(struct ufs_hba *hba, enum ufs_pm_op pm_op,
 	if (!ufs_qcom_is_link_active(hba))
 		ufs_qcom_disable_lane_clks(host);
 
+	if (ufs_qcom_is_link_off(hba)) {
+		err = phy_power_off(phy);
+		if (err) {
+			dev_err(hba->dev, "phy power off failed, ret=%d\n", err);
+			return err;
+		}
+	}
 
 	/* reset the connected UFS device during power down */
 	if (ufs_qcom_is_link_off(hba) && host->device_reset) {
@@ -762,9 +771,19 @@ static int ufs_qcom_suspend(struct ufs_hba *hba, enum ufs_pm_op pm_op,
 static int ufs_qcom_resume(struct ufs_hba *hba, enum ufs_pm_op pm_op)
 {
 	struct ufs_qcom_host *host = ufshcd_get_variant(hba);
+	struct phy *phy = host->generic_phy;
 	int err;
 	u32 reg_val;
 
+	if (ufs_qcom_is_link_off(hba)) {
+		err = phy_power_on(phy);
+		if (err) {
+			dev_err(hba->dev, "%s: failed PHY power on: %d\n",
+				__func__, err);
+			return err;
+		}
+	}
+
 	err = ufs_qcom_enable_lane_clks(host);
 	if (err)
 		return err;
@@ -1175,19 +1194,12 @@ static void ufs_qcom_set_caps(struct ufs_hba *hba)
  * @on: If true, enable clocks else disable them.
  * @status: PRE_CHANGE or POST_CHANGE notify
  *
- * There are certain clocks which comes from the PHY so it needs
- * to be managed together along with controller clocks which also
- * provides a better power saving. Hence keep phy_power_off/on calls
- * in ufs_qcom_setup_clocks, so that PHY's regulators & clks can be
- * turned on/off along with UFS's clocks.
- *
  * Return: 0 on success, non-zero on failure.
  */
 static int ufs_qcom_setup_clocks(struct ufs_hba *hba, bool on,
 				 enum ufs_notify_change_status status)
 {
 	struct ufs_qcom_host *host = ufshcd_get_variant(hba);
-	struct phy *phy;
 	int err;
 
 	/*
@@ -1198,8 +1210,6 @@ static int ufs_qcom_setup_clocks(struct ufs_hba *hba, bool on,
 	if (!host)
 		return 0;
 
-	phy = host->generic_phy;
-
 	switch (status) {
 	case PRE_CHANGE:
 		if (on) {
@@ -1216,22 +1226,10 @@ static int ufs_qcom_setup_clocks(struct ufs_hba *hba, bool on,
 				/* disable device ref_clk */
 				ufs_qcom_dev_ref_clk_ctrl(host, false);
 			}
-
-			err = phy_power_off(phy);
-			if (err) {
-				dev_err(hba->dev, "phy power off failed, ret=%d\n", err);
-				return err;
-			}
 		}
 		break;
 	case POST_CHANGE:
 		if (on) {
-			err = phy_power_on(phy);
-			if (err) {
-				dev_err(hba->dev, "phy power on failed, ret = %d\n", err);
-				return err;
-			}
-
 			/* enable the device ref clock for HS mode*/
 			if (ufshcd_is_hs_mode(&hba->pwr_info))
 				ufs_qcom_dev_ref_clk_ctrl(host, true);
-- 
